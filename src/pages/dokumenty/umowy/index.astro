---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import DocumentList from "../../../components/DocumentList.astro";
import documents from "../../../data/documents.json";

const filteredDocs = documents.filter((doc) => ["umowy", "zalaczniki"].includes(doc.category));
---

<BaseLayout
  currentPath="/dokumenty/umowy/"
  title="Umowa o pracę młodocianego - wzory i załączniki"
  description="Wzory umów o pracę w celu przygotowania zawodowego oraz załączniki dla pracodawców współpracujących ze Szkołą Mistrzów."
>
  <main>
    <section class="section page-hero">
      <div class="section-inner">
        <span class="eyebrow">Dokumenty</span>
        <h1>Umowy o pracę i załączniki</h1>
        <p class="muted">Wzory umów o pracę w celu przygotowania zawodowego oraz załączniki do umów.</p>
      </div>
    </section>
    <section class="section">
      <div class="section-inner">
        <DocumentList documents={filteredDocs} />
      </div>
    </section>
  </main>
</BaseLayout>
