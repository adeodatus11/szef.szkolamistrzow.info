---
import BaseLayout from "../layouts/BaseLayout.astro";
import announcements from "../data/announcements.json";
import events from "../data/events.json";

const sortedEvents = [...events].sort((a, b) => a.date.localeCompare(b.date));
const referenceDate = "2026-05-22";
const upcomingEvents = sortedEvents.filter((event) => (event.endDate ?? event.date) >= referenceDate).slice(0, 4);
const urgentAnnouncements = announcements.slice(0, 3);
const formatDate = (value: string) => new Intl.DateTimeFormat("pl-PL", { day: "2-digit", month: "short" }).format(new Date(value));
const quickCards = [
  { href: "/baza-wiedzy/", title: "Baza wiedzy", text: "Zasady zatrudniania młodocianych, czas pracy, urlopy, BHP i obowiązki stron." },
  { href: "/dokumenty/umowy/", title: "Umowy i załączniki", text: "Wzory umów o pracę w celu przygotowania zawodowego oraz załączniki." },
  { href: "/programy-nauczania/", title: "Programy nauczania", text: "Miejsce na programy i podstawy programowe dla zawodów." },
  { href: "/kontakt/", title: "Kontakt", text: "Dane szkoły, skrzynka ePUAP, e-doręczenia i zasady fakturowania." }
];
---

<BaseLayout
  currentPath="/"
  title="Strefa Pracodawcy ZSZ5 Wrocław - młodociani"
  description="Pulpit dla pracodawców Szkoły Mistrzów: komunikaty, kalendarz roku szkolnego, umowy, dokumenty i baza wiedzy o przygotowaniu zawodowym młodocianych."
>
  <main>
    <section class="section hero compact-hero">
      <div class="section-inner hero-grid">
        <div class="hero-copy">
          <span class="eyebrow">Model dualny i praktyczna nauka zawodu</span>
          <h1>Strefa Pracodawcy Szkoły Mistrzów</h1>
          <p>Krótki pulpit dla pracodawców: najważniejsze komunikaty, terminy, dokumenty i merytoryczna baza wiedzy oparta na źródłach PIP, gov.pl, ELI i ORE.</p>
          <div class="hero-actions">
            <a class="button primary" href="/baza-wiedzy/">Przejdź do bazy wiedzy</a>
            <a class="button secondary" href="/dokumenty/umowy/">Pobierz dokumenty</a>
            <a class="button secondary" href="/kalendarz/">Sprawdź kalendarz</a>
          </div>
        </div>
        <aside class="dashboard" aria-label="Pulpit pracodawcy">
          <div class="panel">
            <h2>Najbliższe terminy</h2>
            <ul class="event-list">
              {upcomingEvents.map((event) => (
                <li class="event-item">
                  <span class="event-date">{formatDate(event.date)}</span>
                  <span><strong>{event.title}</strong><br /><span class="muted">{event.description}</span></span>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="section">
      <div class="section-inner">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Szybki dostęp</span>
            <h2>Najważniejsze miejsca</h2>
          </div>
        </div>
        <div class="content-grid">
          {quickCards.map((card) => (
            <a class="card link-card" href={card.href}>
              <h3>{card.title}</h3>
              <p class="muted">{card.text}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="section logo-strip">
      <div class="section-inner logo-strip-grid">
        <div>
          <span class="eyebrow">Komunikaty</span>
          <h2>Aktualne informacje dla pracodawców</h2>
          <p class="muted">Strona główna pozostaje krótka. Szczegóły są przeniesione do podstron tematycznych.</p>
        </div>
        <div class="dashboard">
          {urgentAnnouncements.map((item) => (
            <article class="priority-item">
              <span class="tag">{item.priority}</span>
              <strong>{item.title}</strong>
              <span class="muted">{item.summary}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

  </main>
</BaseLayout>
